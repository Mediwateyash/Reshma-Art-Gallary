# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/reshmas_art_gallery?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reshmas_art_gallery

# Client URL for CORS
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin User Credentials (for automatic database seeding)
ADMIN_NAME=Gallery Admin
ADMIN_EMAIL=admin@reshmagallery.com
ADMIN_PASSWORD=change_this_to_a_secure_password
